DISCORD_TOKEN=
DISCORD_APP_ID=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
# Optional: Flush interval in ms for Mistral batch STT (default: 5000)
# MISTRAL_FLUSH_INTERVAL_MS=5000
# Optional: Comma-separated context bias terms for Mistral STT (character names, spells, etc.)
# MISTRAL_CONTEXT_BIAS=Tordek,Strahd,Phandalin,Eldritch Blast
# Optional: Realtime model name for Mistral realtime STT
# MISTRAL_REALTIME_MODEL=voxtral-mini-transcribe-realtime-2602
# Optional: Timeout for realtime websocket connect (ms)
# MISTRAL_REALTIME_CONNECT_TIMEOUT_MS=10000
# Optional: Flush transcript buffer to DB after speaker silence (ms)
# MISTRAL_REALTIME_SILENCE_TIMEOUT_MS=1200
# Optional: Max buffered outbound realtime audio bytes before dropping oldest audio
# MISTRAL_REALTIME_MAX_QUEUE_BYTES=512000
# Optional: Max buffered partial text chars before forcing transcript emission
# MISTRAL_REALTIME_MAX_BUFFERED_TEXT_CHARS=4000
# STT provider options: deepgram | assemblyai | mistral | mistral-realtime
STT_PROVIDER=deepgram
TTS_PROVIDER=deepgram
TTS_VOICE=aura-asteria-en
TTS_VOICE_OPTIONS=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
CARTESIA_BASE_URL=https://api.cartesia.ai
INWORLD_API_KEY=
NEXT_API_URL=http://localhost:3000/api
BOT_SECRET=
BOT_HTTP_PORT=3001
