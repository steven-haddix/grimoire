DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB
# Used for image generation AND for campaign-history search embeddings
# (text-embedding-3-small). Without it, search falls back to keyword-only.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Powers the Discord agent and session summaries (Claude Sonnet 5 via @ai-sdk/anthropic).
ANTHROPIC_API_KEY=
# Optional Claude reasoning effort overrides: low | medium | high | xhigh | max.
# Adaptive thinking is always on; effort tunes depth vs. latency/cost.
# Defaults: agent = medium (latency-sensitive), summaries = high (background).
AGENT_EFFORT=
SUMMARY_EFFORT=
# Image generation provider for the /grim scene illustrate tool.
# "gemini" (default) uses gemini-3-pro-image-preview directly via @ai-sdk/google.
# "openai" uses gpt-image-2 via @ai-sdk/openai. The other provider is used as a fallback on error.
IMAGE_PROVIDER=gemini
BOT_SECRET=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=https://us.cloud.langfuse.com
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXT_PUBLIC_DISCORD_APP_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
