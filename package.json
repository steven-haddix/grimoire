{
  "name": "dnd-scribe-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "bun --filter web dev",
    "dev:bot": "bun --filter bot dev",
    "build:web": "bun --filter web build",
    "start:bot": "bun --filter bot start",
    "db:generate": "bun --filter web db:generate",
    "db:migrate": "bun --filter web db:migrate",
    "db:push": "bun --filter web db:push",
    "db:seed": "bun --filter web db:seed",
    "db:studio": "bun --filter web db:studio",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check ."
  },
  "packageManager": "bun@1.3.3",
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "^1.3.6",
    "bun-types": "^1.3.6"
  },
  "trustedDependencies": [
    "@discordjs/opus"
  ]
}
